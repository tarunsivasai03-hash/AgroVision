<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AgroVision" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/leaf</item>
        <item name="colorOnPrimary">@color/on_leaf</item>
        <item name="colorPrimaryContainer">@color/leaf_wash</item>
        <item name="colorOnPrimaryContainer">@color/leaf_deep</item>
        <item name="colorSecondary">@color/turmeric</item>
        <item name="colorOnSecondary">@color/on_turmeric</item>
        <item name="colorSecondaryContainer">@color/leaf_wash</item>
        <item name="colorOnSecondaryContainer">@color/leaf_deep</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface_2</item>
        <item name="colorOnSurfaceVariant">@color/ink_3</item>
        <item name="colorOutline">@color/rule</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/light_system_bars</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_3</item>
        <item name="materialButtonStyle">@style/Widget.AgroVision.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.AgroVision.Button.Outlined</item>
    </style>

    <!-- Type scale: one size per role, sentence case everywhere -->
    <style name="Text.Title" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>
    <style name="Text.Heading" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="Text.Small" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_3</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <!-- Panels: flat, one rule line, no shadow -->
    <style name="Widget.AgroVision.Panel" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/rule</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Buttons are 56dp tall for thumbs and work gloves. Turmeric marks the one main action per screen. -->
    <style name="Widget.AgroVision.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">10dp</item>
        <item name="iconGravity">textStart</item>
    </style>
    <style name="Widget.AgroVision.Button.Primary">
        <item name="backgroundTint">@color/turmeric</item>
        <item name="android:textColor">@color/on_turmeric</item>
        <item name="iconTint">@color/on_turmeric</item>
    </style>
    <style name="Widget.AgroVision.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/rule</item>
        <item name="android:textColor">@color/leaf</item>
        <item name="iconTint">@color/leaf</item>
        <item name="iconGravity">textStart</item>
    </style>
    <style name="Widget.AgroVision.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/leaf</item>
        <item name="iconTint">@color/leaf</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.AgroVision.Nav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
</resources>
