# Copy to .env and set your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
# "-latest" names stay current; fixed names (e.g. gemini-2.0-flash) get retired. Free quota is per model.
GEMINI_MODEL=gemini-flash-latest
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- Optional settings (defaults shown) ---
# FLASK_DEBUG=0                 # 1 enables the debugger; never on a shared network
# FLASK_HOST=127.0.0.1          # 0.0.0.0 to allow phones on your Wi-Fi to connect
# PORT=5000
# CORS_ORIGINS=                 # comma-separated origins allowed to call /api/* from other sites
# AI_RATE_LIMIT=10 per minute;100 per day        # per IP, for chat and scheme advice
# TRANSLATE_RATE_LIMIT=30 per minute;500 per day
# PREDICT_RATE_LIMIT=10 per minute
# RATELIMIT_STORAGE_URI=memory://                # use redis://... with several workers
# HELPLINE_NUMBER=              # AgroVision phone helpline; the Helpline page shows it once set

# --- Leaf scan checks (see README) ---
# LEAF_CHECK=required                 # required | optional | off
# LEAF_CHECK_TIMEOUT_SECONDS=15       # how long to wait for the Gemini photo check
# MIN_PREDICTION_CONFIDENCE=0.5       # the model must be this sure inside the confirmed crop
# CROP_AGREEMENT_MIN=0.5              # share of the model's probability that must sit on the crop in the photo
# UNVERIFIED_MIN_CONFIDENCE=0.9       # stricter bar when LEAF_CHECK is optional/off and no check ran
# TRANSLATION_CACHE_PATH=             # default: instance/translation_cache.json
